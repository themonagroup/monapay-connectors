CONNECTOR_PLATFORM=shopify
MONA_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

HOST=127.0.0.1
PORT=8787
ORDER_ID_REGEX=MONA\s+SHOPIFY\s+(?<orderId>\d+)
PLATFORM_TIMEOUT_MS=2000
RETRY_DELAY_MS=250
IDEMPOTENCY_TTL_MS=86400000
IDEMPOTENCY_MAX_ENTRIES=10000
LOG_LEVEL=info

# Thêm các biến riêng của adapter; xem connectors/adapters/<platform>/README.md.
