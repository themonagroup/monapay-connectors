{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="float-end"><button type="submit" form="form-monapay" class="btn btn-primary">{{ button_save }}</button><a href="{{ back }}" class="btn btn-light">{{ button_cancel }}</a></div><h1>{{ heading_title }}</h1></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    <div class="card"><div class="card-header">{{ text_edit }}</div><div class="card-body">
      <form id="form-monapay" action="{{ save }}" method="post">
        {% set fields = {
          'title': entry_title, 'base_url': entry_base_url, 'username': entry_username,
          'password': entry_password, 'client_secret': entry_client_secret,
          'webhook_secret': entry_webhook_secret, 'owner_number': entry_owner_number,
          'owner_type': entry_owner_type, 'merchant_id': entry_merchant_id,
          'terminal_id': entry_terminal_id, 'va_prefix': entry_va_prefix,
          'beneficiary_name': entry_beneficiary_name
        } %}
        {% for key, label in fields %}
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ label }}</label><div class="col-sm-9"><input class="form-control" name="payment_monapay_{{ key }}" value="{{ attribute(_context, 'payment_monapay_' ~ key) }}" {% if key in ['password','client_secret','webhook_secret'] %}type="password" autocomplete="new-password"{% endif %}></div></div>
        {% endfor %}
        <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_order_status }}</label><div class="col-sm-9"><select class="form-select" name="payment_monapay_order_status_id">{% for status in order_statuses %}<option value="{{ status.order_status_id }}" {% if status.order_status_id == payment_monapay_order_status_id %}selected{% endif %}>{{ status.name }}</option>{% endfor %}</select></div></div>
        <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_status }}</label><div class="col-sm-9"><select class="form-select" name="payment_monapay_status"><option value="1" {% if payment_monapay_status %}selected{% endif %}>Enabled</option><option value="0" {% if not payment_monapay_status %}selected{% endif %}>Disabled</option></select></div></div>
      </form>
    </div></div>
  </div>
</div>
{{ footer }}
