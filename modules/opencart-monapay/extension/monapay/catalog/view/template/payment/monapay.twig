<div id="monapay-payment">
  <p>Nhấn bên dưới để tạo VietQR đúng số tiền cho đơn hàng.</p>
  <button type="button" id="button-monapay" class="btn btn-primary">Tạo VietQR</button>
  <div id="monapay-result" class="mt-3" hidden>
    <label for="monapay-qr-payload">Chuỗi VietQR (EMVCo)</label>
    <textarea id="monapay-qr-payload" class="form-control" rows="4" readonly></textarea>
    <p id="monapay-va"></p>
  </div>
</div>
<script>
document.getElementById('button-monapay').addEventListener('click', async () => {
  const button = document.getElementById('button-monapay');
  button.disabled = true;
  try {
    const response = await fetch('{{ confirm }}', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    const result = await response.json();
    if (result.error) throw new Error(result.error);
    document.getElementById('monapay-qr-payload').value = result.data.qr_data_url || '';
    document.getElementById('monapay-va').textContent = 'Số tài khoản ảo: ' + (result.data.virtual_account_number || '—');
    document.getElementById('monapay-result').hidden = false;
    // TODO: kiểm với checkout theme OpenCart 4 và renderer QR nội bộ của shop.
  } catch (error) {
    window.alert(error.message);
  } finally {
    button.disabled = false;
  }
});
</script>
