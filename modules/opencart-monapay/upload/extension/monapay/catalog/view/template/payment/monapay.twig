<div id="monapay-payment">
  <p>Đơn hàng sẽ được chuyển sang trang thanh toán bảo mật của MONA Pay.</p>
  <button type="button" id="button-monapay" class="btn btn-primary">Thanh toán qua MONA Pay</button>
</div>
<script>
document.getElementById('button-monapay').addEventListener('click', async () => {
  const button = document.getElementById('button-monapay');
  button.disabled = true;

  try {
    const response = await fetch('{{ confirm }}', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    const result = await response.json();
    if (result.error) throw new Error(result.error);
    if (!result.redirect) throw new Error('MONA Pay không trả URL thanh toán.');
    window.location.assign(result.redirect);
  } catch (error) {
    window.alert(error.message);
    button.disabled = false;
  }
});
</script>
