SHOPIFY_API_KEY=replace_with_partner_app_client_id
SHOPIFY_API_SECRET=replace_with_partner_app_client_secret
SHOPIFY_APP_URL=https://shopify.monapay.vn
SHOPIFY_SCOPES=read_orders,write_orders
SHOPIFY_API_VERSION=2026-07

# Tạo bằng: openssl rand -base64 48
APP_SECRET_KEY=replace_with_at_least_32_random_characters
MONAPAY_API_BASE=https://api.monapay.vn

PORT=8793
HOST=127.0.0.1
DATA_DIR=/var/lib/monapay-shopify
OUTBOUND_TIMEOUT_MS=5000
